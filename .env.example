# ==============================================================================
# Configuración de Conexión a la Base de Datos Institucional
# ==============================================================================
# Complete con las credenciales del usuario de solo lectura dentro de la red interna / VPN.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_VIEW=

# Modo Demostración (true/false)
# Si es true, o si la conexión al servidor falla, se utilizarán datos sintéticos
# realistas según la distribución descrita en el MVP para pruebas y validación.
DEMO_MODE=false
